ADDR=:8080
DATABASE_URL=postgres://qrisgate:qrisgate@localhost:5432/qrisgate?sslmode=disable
REDIS_ADDR=localhost:6379
ADMIN_TOKEN=change-me
METRICS_ENABLED=true
METRICS_ADDR=:9090

# Rate limit for POST/GET /v1/payments (requests per minute per IP)
RATE_LIMIT_PER_MIN=100

# Default payment TTL when expires_in is omitted (seconds)
DEFAULT_EXPIRES_IN_SEC=900

# HTTP server timeouts (seconds)
HTTP_READ_TIMEOUT_SEC=15
HTTP_WRITE_TIMEOUT_SEC=30
HTTP_IDLE_TIMEOUT_SEC=60
HTTP_BODY_LIMIT=64K

# OTLP gRPC endpoint (Jaeger). Leave empty to disable tracing locally.
# Docker observability stack: jaeger:4317
# Local Jaeger: localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=qrisgate-api
ENV=development

# Swagger UI at /swagger (development only; blocked when ENV=production)
SWAGGER_ACTIVE=false
